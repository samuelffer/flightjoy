<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#141414"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/txtEditButtonTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EDIT BUTTON"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Button Name:"
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/edtButtonLabel"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="#0A0A0A"
        android:inputType="textCapCharacters"
        android:maxLength="16"
        android:paddingHorizontal="10dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Target vJoy Button on PC (1 to 32):"
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spnTargetVJoyButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Button Behavior:"
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

    <RadioGroup
        android:id="@+id/rgButtonBehavior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rbSingleClick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#FFFFFF"
            android:checked="true"
            android:text="Single Click (Normal tap)"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/rbHoldMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#FFFFFF"
            android:text="Hold (Active while holding finger)"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </RadioGroup>

</LinearLayout>
