<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#161616"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/txtEditButtonTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EDITAR BOTÃO"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Nome Exibido no Botão:"
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/edtButtonLabel"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="#0A0A0A"
        android:inputType="textCapCharacters"
        android:maxLength="16"
        android:paddingHorizontal="10dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Botão vJoy Correspondente no PC (1 a 32):"
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spnTargetVJoyButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp" />

    <CheckBox
        android:id="@+id/chkButtonToggleMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Modo Interruptor (Liga/Desliga ao tocar)"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

</LinearLayout>
