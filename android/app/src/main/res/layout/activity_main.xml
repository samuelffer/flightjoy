<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:keepScreenOn="true">

    <!-- COCKPIT PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- LADO ESQUERDO: Slider Vertical Grosso de Potência (Throttle) -->
        <LinearLayout
            android:layout_width="86dp"
            android:layout_height="match_parent"
            android:background="@color/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POTÊNCIA"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtThrottleValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="0%"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.flightjoy.android.ui.ThickSliderView
                android:id="@+id/sliderThrottle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- CENTRO: Botão Menu (3 Listras), Indicador do Giroscópio e Calibração -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1.15"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Topo Central: Botão 3 Listras + Status + Botão Calibrar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMenu"
                    android:layout_width="42dp"
                    android:layout_height="36dp"
                    android:backgroundTint="#262626"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="☰"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtConnectionStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="Desconectado"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCalibrate"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#262626"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="74dp"
                    android:paddingHorizontal="10dp"
                    android:text="Calibrar"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Indicador do Giroscópio no Meio -->
            <com.flightjoy.android.ui.VirtualStickView
                android:id="@+id/virtualStickView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginVertical="4dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtOrientationValues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="PITCH +0%   •   ROLL +0%"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:typeface="monospace" />
        </LinearLayout>

        <!-- LADO DIREITO: Botões Organizados + Slider Inferior de Rudder (Pedais) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.45"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="COMANDOS DE VOO"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Segure um botão p/ editar"
                    android:textColor="#666666"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Grade Organizada de 8 Botões Editáveis -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnCount="4"
                android:rowCount="2">

                <Button
                    android:id="@+id/btnB1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#222222"
                    android:padding="2dp"
                    android:text="GATILHO"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnB2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#222222"
                    android:padding="2dp"
                    android:text="FREIOS"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnB3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#222222"
                    android:padding="2dp"
                    android:text="FLAPS -"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnB4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#222222"
                    android:padding="2dp"
                    android:text="FLAPS +"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnB5"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#222222"
                    android:padding="2dp"
                    android:text="TREM POUSO"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnB6"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#222222"
                    android:padding="2dp"
                    android:text="SPOILER"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnB7"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#222222"
                    android:padding="2dp"
                    android:text="PILOTO AUTO"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnB8"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:backgroundTint="#222222"
                    android:padding="2dp"
                    android:text="CÂMERA"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </GridLayout>

            <!-- LADO DIREITO INFERIOR: Slider Grosso do Rudder (Pedais) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RUDDER (PEDAIS)"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRudderValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="0%"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnRudderCenter"
                        android:layout_width="60dp"
                        android:layout_height="26dp"
                        android:backgroundTint="#262626"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:text="Centrar"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <com.flightjoy.android.ui.ThickSliderView
                    android:id="@+id/sliderRudder"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- JANELA MODAL NA TELA (Aberta pelo botão ☰ e fechada pelo X) -->
    <FrameLayout
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#141414"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Cabeçalho da Janela com Botão X -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MENU — CONEXÃO, SENSIBILIDADE E MAPEAMENTO"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCloseMenu"
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:backgroundTint="#2A2A2A"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="✕"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Linha 1: IP, Lupa de Busca Rápida, Porta e Botão Conectar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#1E1E1E"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="IP:"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/edtServerIp"
                            android:layout_width="145dp"
                            android:layout_height="38dp"
                            android:background="#0A0A0A"
                            android:hint="192.168.1.100"
                            android:inputType="textUri"
                            android:paddingHorizontal="8dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textColorHint="#666666"
                            android:textSize="13sp" />

                        <!-- Botão de Lupa (Busca Rápida de PC na Rede) -->
                        <Button
                            android:id="@+id/btnSearchPc"
                            android:layout_width="44dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="12dp"
                            android:backgroundTint="#303030"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            android:text="🔍"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:text="Porta:"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/edtServerPort"
                            android:layout_width="72dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="12dp"
                            android:background="#0A0A0A"
                            android:inputType="number"
                            android:paddingHorizontal="8dp"
                            android:singleLine="true"
                            android:text="49152"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnConnect"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:backgroundTint="#FFFFFF"
                            android:text="Conectar"
                            android:textAllCaps="false"
                            android:textColor="#0A0A0A"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Seção 2: Mapeamento de Eixos vJoy (Exclusivo no Celular) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#1E1E1E"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="MAPEAMENTO DE EIXOS NO VJOY (PC)"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pitch (Arfagem)"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                                <Spinner
                                    android:id="@+id/spnMapPitch"
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Roll (Rolagem)"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                                <Spinner
                                    android:id="@+id/spnMapRoll"
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rudder (Pedais)"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                                <Spinner
                                    android:id="@+id/spnMapRudder"
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Throttle (Potência)"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                                <Spinner
                                    android:id="@+id/spnMapThrottle"
                                    android:layout_width="match_parent"
                                    android:layout_height="36dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Seção 3: Sensibilidade, Zona Morta e Opções -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="#1E1E1E"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/txtSensitivityLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sensibilidade do Giroscópio: 1.00x"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekSensitivity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="250"
                            android:progress="100" />

                        <TextView
                            android:id="@+id/txtDeadzoneLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Zona Morta Central: 3%"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekDeadzone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="30"
                            android:progress="3" />

                        <TextView
                            android:id="@+id/txtMaxAngleLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Ângulo Máximo de Inclinação: 45°"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekMaxAngle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="80"
                            android:progress="45" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <CheckBox
                                android:id="@+id/chkInvertPitch"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Inverter Pitch"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <CheckBox
                                android:id="@+id/chkInvertRoll"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Inverter Roll"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <CheckBox
                                android:id="@+id/chkInvertYaw"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Inverter Rudder"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <CheckBox
                                android:id="@+id/chkEnableYaw"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Giroscópio no Yaw"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Rodapé do Menu: Restaurar Botões Padrão -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnResetButtons"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:backgroundTint="#2A2A2A"
                            android:text="Restaurar Botões Padrão"
                            android:textAllCaps="false"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
