<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Barra Superior: Conexão, Pareamento e Calibração -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="FLIGHTJOY"
            android:textColor="@color/accent_blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtServerIp"
            android:layout_width="135dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@color/bg_input"
            android:hint="IP do PC"
            android:inputType="textUri"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:text="192.168.1.100"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/edtServerPort"
            android:layout_width="68dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@color/bg_input"
            android:hint="Porta"
            android:inputType="number"
            android:paddingHorizontal="6dp"
            android:singleLine="true"
            android:text="49152"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/edtPairingPin"
            android:layout_width="76dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@color/bg_input"
            android:gravity="center"
            android:hint="PIN"
            android:inputType="number"
            android:paddingHorizontal="6dp"
            android:singleLine="true"
            android:text="482910"
            android:textColor="@color/accent_blue"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/accent_blue"
            android:text="Conectar"
            android:textAllCaps="false"
            android:textColor="@color/bg_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCalibrate"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#334155"
            android:text="Calibrar Centro"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#334155"
            android:text="Ajustes"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtConnectionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:singleLine="true"
            android:text="Desconectado"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Área Central do Cockpit (3 Colunas) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Coluna Esquerda: Throttle Slider + Botões B1..B4 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtThrottleValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="THR (Potência): 0%"
                    android:textColor="@color/accent_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnThrottleIdle"
                    android:layout_width="56dp"
                    android:layout_height="32dp"
                    android:backgroundTint="#334155"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="0%"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekThrottle"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginVertical="4dp"
                android:max="1000"
                android:progress="0" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnCount="2"
                android:rowCount="2">

                <Button
                    android:id="@+id/btnB1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#0284C7"
                    android:text="B1\nGatilho"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnB2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#334155"
                    android:text="B2\nTrem Pouso"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnB3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#334155"
                    android:text="B3\nFlaps -"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnB4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#334155"
                    android:text="B4\nFlaps +"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </GridLayout>
        </LinearLayout>

        <!-- Coluna Central: Horizonte / Manche Virtual (Giroscópio) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1.3"
            android:background="@color/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <com.flightjoy.android.ui.VirtualStickView
                android:id="@+id/virtualStickView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtOrientationValues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Pitch: +0.0%  |  Roll: +0.0%  |  Yaw: +0.0%"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:typeface="monospace" />
        </LinearLayout>

        <!-- Coluna Direita: Slider Auxiliar/Trim + Botões B5..B8 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:background="@color/bg_card"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtAuxValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AUX / TRIM: 0%"
                    android:textColor="@color/accent_amber"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAuxCenter"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    android:backgroundTint="#334155"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="Centro"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekAux"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginVertical="4dp"
                android:max="1000"
                android:progress="500" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnCount="2"
                android:rowCount="2">

                <Button
                    android:id="@+id/btnB5"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#334155"
                    android:text="B5\nFreios"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnB6"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#334155"
                    android:text="B6\nCâmera"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnB7"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#334155"
                    android:text="B7\nPiloto Auto"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnB8"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_margin="4dp"
                    android:backgroundTint="#334155"
                    android:text="B8\nSpoiler"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </GridLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
