<Window x:Class="FlightJoy.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlightJoy"
        Icon="pack://application:,,,/app.ico"
        Width="590"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#0A0A0A"
        Foreground="#FFFFFF">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border Background="#0A0A0A"
            BorderBrush="#2E2E2E"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Cabeçalho Personalizado no Tema Escuro (Apenas Minimizar e Fechar p/ 2º Plano) -->
                <RowDefinition Height="36" />
                <!-- Conteúdo Principal -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- BARRA DE TÍTULO PERSONALIZADA (PRETO, BRANCO E CINZA) -->
            <Border Grid.Row="0"
                    Background="#121212"
                    BorderBrush="#262626"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid Margin="14,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/icon.png"
                               Width="20"
                               Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="FlightJoy"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E0E0E0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="  •  Cliente PC"
                                   FontSize="11"
                                   Foreground="#757575"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Apenas Minimizar (—) e Fechar (✕ -> envia para Ícones Ocultos em 2º Plano) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="36"
                                Height="26"
                                Margin="0,0,2,0"
                                Padding="0"
                                Background="#1A1A1A"
                                BorderBrush="#2E2E2E"
                                BorderThickness="1"
                                Content="—"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#E0E0E0"
                                Cursor="Hand"
                                ToolTip="Minimizar para a barra de tarefas"
                                Click="OnMinimizeTitleBarClick" />

                        <Button Width="36"
                                Height="26"
                                Padding="0"
                                Background="#1A1A1A"
                                BorderBrush="#2E2E2E"
                                BorderThickness="1"
                                Content="✕"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#FFFFFF"
                                Cursor="Hand"
                                ToolTip="Fechar para 2º plano (Ícones Ocultos)"
                                Click="OnCloseToTrayTitleBarClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTEÚDO PRINCIPAL COMPACTO -->
            <StackPanel Grid.Row="1" Margin="16,14,16,14">

                <!-- 1. Cabeçalho de Rede e Servidor -->
                <Border Background="#161616"
                        BorderBrush="#2E2E2E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="FLIGHTJOY"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           Margin="0,0,10,0" />
                                <TextBlock Text="{Binding MachineName, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="#9E9E9E"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="IP: "
                                           FontSize="12"
                                           Foreground="#9E9E9E" />
                                <TextBlock Text="{Binding LocalIpSummary}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#E0E0E0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Porta:"
                                       VerticalAlignment="Center"
                                       Foreground="#9E9E9E"
                                       FontSize="12"
                                       Margin="0,0,6,0" />
                            <TextBox Width="64"
                                     Padding="6,4"
                                     Background="#0A0A0A"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#2E2E2E"
                                     Text="{Binding UdpPort, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0" />

                            <TextBlock Text="vJoy:"
                                       VerticalAlignment="Center"
                                       Foreground="#9E9E9E"
                                       FontSize="12"
                                       Margin="0,0,6,0" />
                            <ComboBox Width="52"
                                      Padding="6,4"
                                      SelectedValue="{Binding VJoyDeviceId}"
                                      SelectedValuePath="Content"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" />
                            </ComboBox>

                            <Button Content="{Binding ServerButtonText}"
                                    Padding="14,5"
                                    Background="#FFFFFF"
                                    Foreground="#0A0A0A"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="OnToggleServerClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Status de Conexão e vJoy (com espaçamento protegido para não encavalar) -->
                <Border Background="#161616"
                        BorderBrush="#2E2E2E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Celular: "
                                       Foreground="#9E9E9E"
                                       FontSize="12" />
                            <TextBlock Text="{Binding ConnectionBadgeText}"
                                       Foreground="#FFFFFF"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       MaxWidth="195"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding VJoyBadgeText}"
                                   Foreground="#9E9E9E"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,0,10,0" />

                        <Button Grid.Column="2"
                                Content="Reconectar"
                                Padding="10,4"
                                Background="#262626"
                                Foreground="#E0E0E0"
                                BorderBrush="#383838"
                                FontSize="11"
                                Cursor="Hand"
                                Click="OnReconnectVJoyClick" />
                    </Grid>
                </Border>

                <!-- 3. Monitoramento dos Eixos (incluindo Reverso) e Botões -->
                <Border Background="#161616"
                        BorderBrush="#2E2E2E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Axes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   Foreground="#E0E0E0"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />

                                        <ProgressBar Grid.Column="1"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProcessedPercentBarValue, Mode=OneWay}"
                                                     Height="10"
                                                     Background="#0A0A0A"
                                                     Foreground="#FFFFFF"
                                                     BorderBrush="#2E2E2E"
                                                     BorderThickness="1"
                                                     VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ProcessedPercentText}"
                                                   Foreground="#FFFFFF"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#0E0E0E"
                                BorderBrush="#262626"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,7"
                                Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Botões vJoy Acionados: "
                                           Foreground="#9E9E9E"
                                           FontSize="12" />
                                <TextBlock Text="{Binding ActiveButtonsText}"
                                           Foreground="#FFFFFF"
                                           FontWeight="SemiBold"
                                           FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. Logs Retráteis -->
                <Border Visibility="{Binding LogsVisibility}"
                        Background="#161616"
                        BorderBrush="#2E2E2E"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="95"
                        Padding="8"
                        Margin="0,0,0,10">
                    <ListBox ItemsSource="{Binding Logs}"
                             Background="#0A0A0A"
                             Foreground="#BDBDBD"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="10" />
                </Border>

                <!-- 5. Rodapé -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding TelemetryText}"
                               Foreground="#9E9E9E"
                               FontFamily="Consolas"
                               FontSize="11"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Logs"
                                Padding="12,4"
                                Background="#1E1E1E"
                                Foreground="#BDBDBD"
                                BorderBrush="#2E2E2E"
                                FontSize="11"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                Click="OnToggleLogsClick" />
                        <Button Content="Encerrar"
                                Padding="12,4"
                                Background="#1E1E1E"
                                Foreground="#FFFFFF"
                                BorderBrush="#2E2E2E"
                                FontSize="11"
                                Cursor="Hand"
                                Click="OnForceExitClick" />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>
