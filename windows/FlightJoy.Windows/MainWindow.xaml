<Window x:Class="FlightJoy.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FlightJoy"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgPrimaryBrush}"
            BorderBrush="#2E2E2E"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Cabeçalho Personalizado no Tema (Apenas Minimizar e Fechar p/ 2º Plano) -->
                <RowDefinition Height="36" />
                <!-- Conteúdo Principal -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- BARRA DE TÍTULO PERSONALIZADA (PRETO, BRANCO E CINZA) -->
            <Border Grid.Row="0"
                    Background="#111111"
                    BorderBrush="#242424"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid Margin="14,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="FlightJoy"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E0E0E0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="  •  Cliente PC"
                                   FontSize="11"
                                   Foreground="#757575"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Apenas Minimizar e Fechar (que envia para Ícones Ocultos em 2º Plano) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="34"
                                Height="26"
                                Margin="0,0,2,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Content="—"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#BDBDBD"
                                ToolTip="Minimizar para a barra de tarefas"
                                Click="OnMinimizeTitleBarClick" />

                        <Button Width="34"
                                Height="26"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Content="✕"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#FFFFFF"
                                ToolTip="Fechar para 2º plano (Ícones Ocultos)"
                                Click="OnCloseToTrayTitleBarClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTEÚDO PRINCIPAL COMPACTO -->
            <StackPanel Grid.Row="1" Margin="16,14,16,14">

                <!-- 1. Cabeçalho de Rede e Servidor -->
                <Border Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="FLIGHTJOY"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding MachineName, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="IP: "
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding LocalIpSummary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Porta:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,0,6,0" />
                            <TextBox Width="60"
                                     Text="{Binding UdpPort, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0" />

                            <TextBlock Text="vJoy:"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,0,6,0" />
                            <ComboBox Width="50"
                                      SelectedValue="{Binding VJoyDeviceId}"
                                      SelectedValuePath="Content"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" />
                            </ComboBox>

                            <Button Content="{Binding ServerButtonText}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnToggleServerClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Status de Conexão e vJoy (com espaçamento protegido para não encavalar textos) -->
                <Border Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <TextBlock Text="Celular: "
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" />
                            <TextBlock Text="{Binding ConnectionBadgeText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       MaxWidth="195"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding VJoyBadgeText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,0,10,0" />

                        <Button Grid.Column="2"
                                Content="Reconectar"
                                Padding="10,3"
                                FontSize="11"
                                Click="OnReconnectVJoyClick" />
                    </Grid>
                </Border>

                <!-- 3. Monitoramento dos Eixos (incluindo Reverso) e Botões -->
                <Border Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,12"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Axes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="125" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="58" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center" />

                                        <ProgressBar Grid.Column="1"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProcessedPercentBarValue, Mode=OneWay}"
                                                     Height="10"
                                                     Background="#0A0A0A"
                                                     Foreground="#E0E0E0"
                                                     BorderBrush="#262626"
                                                     BorderThickness="1"
                                                     VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ProcessedPercentText}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#0E0E0E"
                                BorderBrush="#222222"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,6"
                                Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Botões vJoy Acionados: "
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" />
                                <TextBlock Text="{Binding ActiveButtonsText}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. Logs Retráteis -->
                <Border Visibility="{Binding LogsVisibility}"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Height="95"
                        Padding="8"
                        Margin="0,0,0,10">
                    <ListBox ItemsSource="{Binding Logs}"
                             Background="#0A0A0A"
                             Foreground="#BDBDBD"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="10" />
                </Border>

                <!-- 5. Rodapé -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding TelemetryText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Logs"
                                Padding="10,3"
                                FontSize="11"
                                Margin="0,0,6,0"
                                Click="OnToggleLogsClick" />
                        <Button Content="Encerrar"
                                Padding="10,3"
                                FontSize="11"
                                Click="OnForceExitClick" />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>
