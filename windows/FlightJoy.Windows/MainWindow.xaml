<Window x:Class="FlightJoy.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlightJoy"
        Icon="pack://application:,,,/app.ico"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#0A0A0A"
        Foreground="#FFFFFF">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Template de Botão com Cantos Arredondados -->
        <ControlTemplate x:Key="RoundedWhiteButtonTemplate" TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#DCDCDC" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="RoundedDarkButtonTemplate" TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#242424" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#2E2E2E" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="TitleBarButtonTemplate" TargetType="Button">
            <Border x:Name="border"
                    Background="Transparent"
                    CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#222222" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Border Background="#0A0A0A"
            BorderBrush="#242424"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Barra de Título Personalizada -->
                <RowDefinition Height="42" />
                <!-- Corpo Principal -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- BARRA DE TÍTULO ESCURA PERSONALIZADA -->
            <Border Grid.Row="0"
                    Background="#0E0E0E"
                    BorderBrush="#1F1F1F"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/icon.png"
                               Width="22"
                               Height="22"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                        <TextBlock Text="FlightJoy"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#F2F2F2"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Apenas Minimizar e Fechar (envia para Ícones Ocultos em 2º plano) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="34"
                                Height="28"
                                Margin="0,0,4,0"
                                Template="{StaticResource TitleBarButtonTemplate}"
                                Cursor="Hand"
                                ToolTip="Minimizar para a barra de tarefas"
                                Click="OnMinimizeTitleBarClick">
                            <Path Data="M 0,6 L 11,6"
                                  Stroke="#BDBDBD"
                                  StrokeThickness="1.5"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" />
                        </Button>

                        <Button Width="34"
                                Height="28"
                                Template="{StaticResource TitleBarButtonTemplate}"
                                Cursor="Hand"
                                ToolTip="Fechar para 2º plano (Ícones Ocultos)"
                                Click="OnCloseToTrayTitleBarClick">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                  Stroke="#E0E0E0"
                                  StrokeThickness="1.5"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CORPO PRINCIPAL -->
            <StackPanel Grid.Row="1" Margin="20,18,20,18">

                <!-- SEÇÃO SUPERIOR: ESQUERDA (CRUZ PITCH/ROLL + RUDDER) | DIVISOR | DIREITA (IP, PORTA, VJOY, PARAR) -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- COLUNA ESQUERDA: Eixos em Cruz (Pitch & Roll) + Rudder Horizontal Deitado -->
                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <TextBlock Text="PITCH / ROLL"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#8A8A8A"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />

                        <!-- Cruz Simples dos Eixos Pitch (Vertical) e Roll (Horizontal) -->
                        <Canvas Width="128" Height="128" HorizontalAlignment="Center">
                            <!-- Linhas Principais dos Eixos X e Y -->
                            <Line X1="16" Y1="64" X2="112" Y2="64" Stroke="#3A3A3A" StrokeThickness="1.5" />
                            <Line X1="64" Y1="16" X2="64" Y2="112" Stroke="#3A3A3A" StrokeThickness="1.5" />

                            <!-- Marcações nas Extremidades (100%) e Meio (50%) -->
                            <Line X1="16" Y1="60" X2="16" Y2="68" Stroke="#3A3A3A" StrokeThickness="1.5" />
                            <Line X1="112" Y1="60" X2="112" Y2="68" Stroke="#3A3A3A" StrokeThickness="1.5" />
                            <Line X1="60" Y1="16" X2="68" Y2="16" Stroke="#3A3A3A" StrokeThickness="1.5" />
                            <Line X1="60" Y1="112" X2="68" Y2="112" Stroke="#3A3A3A" StrokeThickness="1.5" />

                            <Line X1="40" Y1="61" X2="40" Y2="67" Stroke="#303030" StrokeThickness="1.2" />
                            <Line X1="88" Y1="61" X2="88" Y2="67" Stroke="#303030" StrokeThickness="1.2" />
                            <Line X1="61" Y1="40" X2="67" Y2="40" Stroke="#303030" StrokeThickness="1.2" />
                            <Line X1="61" Y1="88" X2="67" Y2="88" Stroke="#303030" StrokeThickness="1.2" />

                            <!-- Linhas Guias até os Eixos X e Y -->
                            <Line X1="{Binding StickCenterX}" Y1="64"
                                  X2="{Binding StickCenterX}" Y2="{Binding StickCenterY}"
                                  Stroke="#484848" StrokeThickness="1" />
                            <Line X1="64" Y1="{Binding StickCenterY}"
                                  X2="{Binding StickCenterX}" Y2="{Binding StickCenterY}"
                                  Stroke="#484848" StrokeThickness="1" />

                            <!-- Ponto Principal de Posição (Pitch & Roll) -->
                            <Ellipse Width="10" Height="10"
                                     Fill="#FFFFFF"
                                     Canvas.Left="{Binding StickDotLeft}"
                                     Canvas.Top="{Binding StickDotTop}" />
                        </Canvas>

                        <!-- Eixo Rudder Simples na Horizontal Deitado -->
                        <TextBlock Text="RUDDER"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#8A8A8A"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,4" />

                        <Canvas Width="128" Height="20" HorizontalAlignment="Center">
                            <!-- Linha Horizontal Simples, Extremidades e Centro do Rudder -->
                            <Line X1="16" Y1="10" X2="112" Y2="10" Stroke="#3A3A3A" StrokeThickness="1.5" />
                            <Line X1="16" Y1="6" X2="16" Y2="14" Stroke="#3A3A3A" StrokeThickness="1.5" />
                            <Line X1="112" Y1="6" X2="112" Y2="14" Stroke="#3A3A3A" StrokeThickness="1.5" />
                            <Line X1="64" Y1="5" X2="64" Y2="15" Stroke="#484848" StrokeThickness="1.5" />

                            <!-- Ponto do Rudder -->
                            <Ellipse Width="9" Height="9"
                                     Fill="#FFFFFF"
                                     Canvas.Left="{Binding RudderDotLeft}"
                                     Canvas.Top="5.5" />
                        </Canvas>
                    </StackPanel>

                    <!-- LINHA DIVISÓRIA VERTICAL -->
                    <Border Grid.Column="1"
                            Width="1"
                            Background="#222222"
                            HorizontalAlignment="Center"
                            Margin="0,6" />

                    <!-- COLUNA DIREITA: IP, Porta, vJoy e Botão Parar/Iniciar -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">

                        <!-- Linha 1: IP -->
                        <Border Background="#131313"
                                BorderBrush="#1F1F1F"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,5"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Ícone Vetorial Monitor -->
                                    <Path Data="M 1,2 L 15,2 L 15,11 L 1,11 Z M 5,14 L 11,14 M 8,11 L 8,14"
                                          Stroke="#BDBDBD"
                                          StrokeThickness="1.4"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                    <TextBlock Text="IP"
                                               FontSize="12"
                                               Foreground="#BDBDBD"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="#0C0C0C"
                                        BorderBrush="#262626"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,7">
                                    <TextBlock Text="{Binding LocalIpSummary}"
                                               FontSize="13"
                                               Foreground="#EAEAEA"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Linha 2: Porta -->
                        <Border Background="#131313"
                                BorderBrush="#1F1F1F"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,5"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Ícone Vetorial Porta / Rede -->
                                    <Path Data="M 2,4 C 2,2 14,2 14,4 C 14,6 2,6 2,4 Z M 2,4 L 2,12 C 2,14 14,14 14,12 L 14,4 M 2,8 C 2,10 14,10 14,8"
                                          Stroke="#BDBDBD"
                                          StrokeThickness="1.4"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                    <TextBlock Text="Porta"
                                               FontSize="12"
                                               Foreground="#BDBDBD"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="#0C0C0C"
                                        BorderBrush="#262626"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,5">
                                    <TextBox Text="{Binding UdpPort, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             Foreground="#EAEAEA"
                                             CaretBrush="#FFFFFF"
                                             BorderThickness="0"
                                             FontSize="13"
                                             VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Linha 3: vJoy -->
                        <Border Background="#131313"
                                BorderBrush="#1F1F1F"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,5"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Ícone Vetorial Gamepad -->
                                    <Path Data="M 3,4 L 13,4 C 15,4 16,6 15,10 C 14.5,12 13,12 12,10 L 10,8 L 6,8 L 4,10 C 3,12 1.5,12 1,10 C 0,6 1,4 3,4 Z M 5,6 L 5,6.5 M 11,6 L 11,6.5"
                                          Stroke="#BDBDBD"
                                          StrokeThickness="1.4"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                    <TextBlock Text="vJoy"
                                               FontSize="12"
                                               Foreground="#BDBDBD"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Background="#0C0C0C"
                                        BorderBrush="#262626"
                                        BorderThickness="1"
                                        Padding="12,7"
                                        Template="{StaticResource RoundedDarkButtonTemplate}"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        ToolTip="Clique para alternar o dispositivo vJoy (1 a 4)"
                                        Click="OnCycleVJoyDeviceClick">
                                    <Grid Width="210">
                                        <TextBlock Text="{Binding VJoyDeviceId}"
                                                   FontSize="13"
                                                   Foreground="#EAEAEA"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <Path Data="M 0,0 L 4.5,4.5 L 9,0"
                                              Stroke="#BDBDBD"
                                              StrokeThickness="1.5"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,4,0" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Botão Principal: Parar / Iniciar -->
                        <Button Height="42"
                                Background="#F2F2F2"
                                Foreground="#0A0A0A"
                                BorderThickness="0"
                                Template="{StaticResource RoundedWhiteButtonTemplate}"
                                Cursor="Hand"
                                Click="OnToggleServerClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="11"
                                        Height="11"
                                        CornerRadius="2"
                                        Background="#141414"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ServerButtonText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#0A0A0A"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>

                <!-- CARTÃO INFERIOR DE STATUS (CELULAR + VJOY + BOTÃO RECONECTAR) -->
                <Border Background="#121212"
                        BorderBrush="#222222"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Ícone Vetorial Celular -->
                        <Path Grid.Column="0"
                              Data="M 2,1 L 12,1 C 13,1 13,2 13,2 L 13,18 C 13,19 12,19 12,19 L 2,19 C 1,19 1,18 1,18 L 1,2 C 1,1 2,1 2,1 Z M 6,16 L 8,16"
                              Stroke="#D6D6D6"
                              StrokeThickness="1.5"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />

                        <!-- Bolinha de Status (Verde quando conectado, Cinza quando aguardando) -->
                        <Ellipse Grid.Column="1"
                                 Width="8"
                                 Height="8"
                                 Fill="{Binding StatusDotBrush}"
                                 VerticalAlignment="Top"
                                 Margin="0,6,10,0" />

                        <!-- Textos Empilhados: Status do Celular + Status do vJoy -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding ConnectionBadgeText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#F2F2F2"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding VJoyBadgeText}"
                                       FontSize="11"
                                       Foreground="#8A8A8A"
                                       Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Botão Reconectar com Ícone Vetorial de Refresh -->
                        <Button Grid.Column="3"
                                Background="#1A1A1A"
                                BorderBrush="#2E2E2E"
                                BorderThickness="1"
                                Padding="14,8"
                                Template="{StaticResource RoundedDarkButtonTemplate}"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Click="OnReconnectVJoyClick">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 12,4 A 5.5,5.5 0 1 0 13,9 M 12,1 L 12,4.5 L 8.5,4.5"
                                      Stroke="#E0E0E0"
                                      StrokeThickness="1.4"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                                <TextBlock Text="Reconectar"
                                           FontSize="12"
                                           Foreground="#E0E0E0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </Border>
</Window>
