<Window x:Class="FlightJoy.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlightJoy"
        Height="480"
        Width="580"
        MinHeight="430"
        MinWidth="500"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{StaticResource BgPrimary}"
        Foreground="{StaticResource TextPrimary}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho Minimalista (Preto, Branco e Cinza) -->
        <Border Grid.Row="0"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="FLIGHTJOY"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding MachineName}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="#9E9E9E"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="IP: "
                                   Foreground="#9E9E9E"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding LocalIpSummary}"
                                   Foreground="#E0E0E0"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Porta, vJoy ID e Iniciar/Parar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Porta:"
                               VerticalAlignment="Center"
                               Foreground="#9E9E9E"
                               FontSize="12"
                               Margin="0,0,6,0"/>
                    <TextBox Width="56"
                             Text="{Binding UdpPort, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0A0A0A"
                             Foreground="#FFFFFF"
                             BorderBrush="#333333"
                             Padding="5,3"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             Margin="0,0,10,0"/>

                    <TextBlock Text="vJoy:"
                               VerticalAlignment="Center"
                               Foreground="#9E9E9E"
                               FontSize="12"
                               Margin="0,0,5,0"/>
                    <ComboBox Width="48"
                              ItemsSource="{Binding AvailableDeviceIds}"
                              SelectedItem="{Binding VJoyDeviceId}"
                              VerticalContentAlignment="Center"
                              Margin="0,0,8,0"/>

                    <Button Content="{Binding ServerButtonText}"
                            Click="OnToggleServerClick"
                            Padding="12,5"
                            FontWeight="SemiBold"
                            Background="#FFFFFF"
                            Foreground="#0A0A0A"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra de Status Compacta -->
        <Border Grid.Row="1"
                Background="#121212"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,8"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Celular: "
                               Foreground="#9E9E9E"
                               FontSize="12"/>
                    <TextBlock Text="{Binding ConnectionBadgeText}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VJoyBadgeText}"
                               Foreground="#BDBDBD"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button Content="Reconectar"
                            Click="OnReconnectVJoyClick"
                            Padding="8,3"
                            FontSize="11"
                            Background="#262626"
                            Foreground="#E0E0E0"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Monitor Minimalista de Eixos e Botões (Controlados pelo Celular) -->
        <Border Grid.Row="2"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding Axes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="135"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding DisplayName}"
                                           Foreground="#E0E0E0"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                <ProgressBar Grid.Column="1"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ProcessedPercentBarValue, Mode=OneWay}"
                                             Height="10"
                                             Margin="8,0"
                                             Foreground="#FFFFFF"
                                             Background="#0A0A0A"
                                             BorderBrush="#2E2E2E"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding ProcessedPercentText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="#FFFFFF"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1"
                        Background="#0F0F0F"
                        BorderBrush="#262626"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10,7"
                        Margin="0,8,0,0">
                    <DockPanel>
                        <TextBlock Text="Botões vJoy Acionados: "
                                   Foreground="#9E9E9E"
                                   FontSize="12"/>
                        <TextBlock Text="{Binding ActiveButtonsText}"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Painel Opcional de Logs (Oculto por padrão) -->
        <Border Grid.Row="3"
                Visibility="{Binding LogsVisibility}"
                Background="#0F0F0F"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="6"
                Height="100"
                Margin="0,8,0,0"
                Padding="6">
            <ListBox ItemsSource="{Binding Logs}"
                     Background="Transparent"
                     Foreground="#BDBDBD"
                     BorderThickness="0"
                     FontSize="11"
                     FontFamily="Consolas"/>
        </Border>

        <!-- Rodapé Minimalista -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Logs"
                        Click="OnToggleLogsClick"
                        Padding="10,4"
                        Margin="0,0,6,0"
                        FontSize="11"
                        Background="#1F1F1F"
                        Foreground="#BDBDBD"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="Encerrar"
                        Click="OnForceExitClick"
                        Padding="10,4"
                        FontSize="11"
                        Background="#292929"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>

            <TextBlock Text="{Binding TelemetryText}"
                       VerticalAlignment="Center"
                       Foreground="#808080"
                       FontFamily="Consolas"
                       FontSize="11"/>
        </DockPanel>
    </Grid>
</Window>
