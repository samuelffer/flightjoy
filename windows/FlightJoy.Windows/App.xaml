<Application x:Class="FlightJoy.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgPrimary" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="BgCard" Color="#161616"/>
        <SolidColorBrush x:Key="BgInput" Color="#222222"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="AccentWhite" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#2E2E2E"/>

        <!-- Aliases seguros -->
        <SolidColorBrush x:Key="BgPrimaryBrush" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="#161616"/>
        <SolidColorBrush x:Key="BgInputBrush" Color="#222222"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2E2E2E"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0A0A0A"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
